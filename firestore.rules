rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Study time only: users/{uid} holds nova_time, the same day→seconds map
    // as localStorage nova_time. Each signed-in user can touch only their own doc.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.nova_time is map;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
