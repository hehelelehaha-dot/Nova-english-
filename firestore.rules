rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid} holds nova_time (day → seconds) and nova_dq (day → ④ bar:
    // sel, done, extra). Each signed-in user can touch only their own doc.
    // A field that is present must be a map. Writes still need at least one of them.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && ('nova_time' in request.resource.data || 'nova_dq' in request.resource.data)
        && (!('nova_time' in request.resource.data) || request.resource.data.nova_time is map)
        && (!('nova_dq' in request.resource.data) || request.resource.data.nova_dq is map);
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
