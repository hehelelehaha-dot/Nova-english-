a": "audio/t02/s02.mp3", "hl": [8, 27], "sp": "Naval", "oa": "audio/t02o/s02.mp3", "oab": [0, 1.31], "oas": ["audio/t02o/s02.mp3"], "zh": "这是普遍的看法，甚至可能就是你在现实中亲身得来的实际经验。", "zb": [2, 4], "sg": [[0, 28, "audio/t02o/s02.mp3", 0, 1.31], [29, 94, "audio/t02o/s02.mp3", 1.31, 5.02]]}}, {"n": 2, "w": "practical", "pos": "adj.", "zh": "实际的；从实践中来的", "ex": "Practical means it comes from real life and real doing, not from theory. Practical earned experience is what you learned the hard way, by living it. It's also used for things that are useful and sensible.", "exs": ["Wearing flat shoes at work is just more practical.", "She gave me some practical tips for my first week."], "t": 56.12, "tt": {"w": 56.12, "ex": [["Practical", 58.91], ["means", 59.21], ["it", 59.47], ["comes", 59.83], ["from", 60.05], ["real", 61.09], ["life", 61.23], ["and", 61.23], ["real", 61.35], ["doing,", 61.59], ["not", 62.51], ["from", 62.69], ["theory.", 62.91], ["Practical", 64.07], ["earned", 64.55], ["experience", 64.83], ["is", 65.29], ["what", 65.85], ["you", 66.03], ["learned", 66.22], ["the", 66.41], ["hard", 66.65], ["way,", 66.87], ["by", 67.31], ["living", 67.89], ["it.", 68.25], ["It's", 69.11], ["also", 69.19], ["used", 69.33], ["for", 69.81], ["things", 70.07], ["that", 70.41], ["are", 70.69], ["useful", 70.83], ["and", 71.23], ["sensible.", 71.65]], "exs": [[["Wearing", 75.14], ["flat", 75.49], ["shoes", 75.73], ["at", 75.97], ["work", 76.21], ["is", 76.45], ["just", 77.01], ["more", 77.41], ["practical.", 77.67]], [["She", 86.66], ["gave", 86.86], ["me", 87.04], ["some", 87.28], ["practical", 87.52], ["tips", 88.04], ["for", 88.42], ["my", 88.7], ["first", 88.86], ["week.", 89.16]]], "z": [78.93, 90.22], "r": [82.06, 93.37], "o": 97.53, "rx": [[82.06, 82.41, 82.65, 82.89, 83.13, 83.37, 83.93, 84.33, 84.59], [93.37, 93.57, 93.75, 93.99, 94.23, 94.75, 95.13, 95.41, 95.57, 95.87]]}, "src": {"t": "That is conventional wisdom, that may even be the practical earned experience of your reality.",