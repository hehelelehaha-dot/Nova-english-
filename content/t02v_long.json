{"type": "longaudio", "title": "Naval Topic 2 生词 · 英英解释", "audio": "audio/t02v/full.mp3", "items": [{"n": 1, "w": "conventional wisdom", "pos": "n. phrase", "zh": "普遍看法；传统观念", "ex": "Conventional wisdom is what most people believe is true, often without checking. Naval uses it for the common idea that happy people stop trying. We often say it right before we question it.", "exs": ["Conventional wisdom says you need a degree to do well, but plenty of people prove it wrong.", "The conventional wisdom is that mornings are best for workouts."], "t": 0.0, "tt": {"w": 0.0, "ex": [["Conventional", 3.1], ["wisdom", 3.36], ["is", 3.82], ["what", 4.24], ["most", 4.42], ["people", 4.68], ["believe", 5.06], ["is", 5.5], ["true,", 6.08], ["often", 6.6], ["without", 7.04], ["checking.", 7.24], ["Naval", 9.04], ["uses", 9.04], ["it", 9.34], ["for", 9.6], ["the", 9.76], ["common", 9.86], ["idea", 10.18], ["that", 10.72], ["happy", 11.06], ["people", 11.36], ["stop", 11.82], ["trying.", 12.1], ["We", 13.34], ["often", 13.38], ["say", 13.64], ["it", 14.02], ["right", 14.22], ["before", 14.44], ["we", 14.84], ["question", 15.02], ["it.", 15.38]], "exs": [[["Conventional", 18.56], ["wisdom", 18.76], ["says", 19.38], ["you", 19.82], ["need", 20.02], ["a", 20.22], ["degree", 20.34], ["to", 20.62], ["do", 20.93], ["well,", 21.25], ["but", 21.56], ["plenty", 21.96], ["of", 22.18], ["people", 22.52], ["prove", 22.82], ["it", 23.1], ["wrong.", 23.32]], [["The", 30.96], ["conventional", 31.08], ["wisdom", 31.54], ["is", 31.98], ["that", 32.7], ["mornings", 32.86], ["are", 33.32], ["best", 33.62], ["for", 33.84], ["workouts.", 34.12]]], "z": [24.32, 35.38], "o": 39.24}, "src": {"t": "That is conventional wisdom, that may even be the practical earned experience of your reality.", "a": "audio/t02/s02.mp3", "hl": [8, 27], "sp": "Naval", "oa": "audio/t02o/s02.mp3", "oab": [0, 1.31], "oas": ["audio/t02o/s02.mp3"]}}, {"n": 2, "w": "practical", "pos": "adj.", "zh": "实际的；从实践中来的", "ex": "Practical mean