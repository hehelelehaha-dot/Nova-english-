t", 504.29], ["I", 505.01], ["needed", 505.15], ["more", 505.37], ["rest.", 505.71]], [["It", 514.09], ["was", 514.19], ["a", 514.31], ["big", 514.41], ["realization", 514.65], ["for", 515.11], ["me.", 515.79]]], "z": [506.79, 516.67], "r": [509.62, 519.73], "o": 522.91, "rx": [[509.62, 509.74, 509.94, 510.16, 510.26, 510.72, 511.44, 511.58, 511.8, 512.14], [519.73, 519.83, 519.95, 520.05, 520.29, 520.75, 521.43]]}, "src": {"t": "Is that a realization you think you could have gotten to had you not had some success in the first place?", "a": "audio/t02/s12.mp3", "hl": [10, 21], "sp": "Chris", "oa": "audio/t02o/s12.mp3", "oab": [0, 2.47], "oas": ["audio/t02o/s12.mp3"], "zh": "你觉得，如果当初没有先取得一些成功，你还能领悟到这一点吗？", "zb": [21, 23], "sg": [[0, 46, "audio/t02o/s12.mp3", 0, 2.47], [47, 105, "audio/t02o/s12.mp3", 2.47, 5.15]]}}, {"n": 12, "w": "ascetic", "pos": "n./adj.", "zh": "苦行者；禁欲的", "ex": "An ascetic is a person who gives up comfort and pleasure, often for spiritual reasons. Naval says he didn't want to live with nothing, like a monk. Pronounced uh-SET-ik.", "exs": ["He lived like an ascetic, with almost no furniture.", "I'm not going to live an ascetic life just to save money."], "t": 529.26, "tt": {"w": 529.26, "ex": [["An", 532.05], ["ascetic", 532.13], ["is", 532.53], ["a", 532.75], ["person", 532.85], ["who", 533.13], ["gives", 533.41], ["up", 533.59], ["comfort", 533.79], ["and", 534.23], ["pleasure,", 534.49], ["often", 535.33], ["for", 535.61], ["spiritual", 535.85], ["reasons.", 536.27], ["Naval", 537.51], ["says", 537.89], ["he", 538.2], ["didn't", 538.39], ["want", 538.83], ["to", 539.15], ["live", 539.34], ["with", 539.65], ["nothing,", 539.97], ["like", 540.53], ["a", 540.85], ["monk.", 540.97], ["Pronounced", 541.35], ["uh-SET-ik.", 542.04]], "exs": [[["He", 545.99], ["lived", 546.16], ["like", 546.5], ["an", 546.78], ["ascetic,", 546.94], ["with", 547.45], ["almost", 547.72], ["no", 548.11], ["furniture.", 548.28]], [["I'm", 558.67], ["not", 558.9], ["going", 