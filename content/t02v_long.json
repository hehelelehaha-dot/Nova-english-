04], ["get", 277.56], ["into", 277.7], ["the", 277.84], ["arena.", 278.02]]], "z": [269.01, 279.08], "r": [271.4, 281.69], "o": 285.97, "rx": [[271.4, 271.59, 272.01, 272.35, 272.47, 272.73, 273.27, 273.73], [281.69, 282.01, 282.39, 282.79, 282.93, 283.33, 283.85, 283.99, 284.13, 284.31]]}, "src": {"t": "Some people do, maybe it’s in their nature, but I think most people still want to act, they want to live in the arena.", "a": "audio/t02/s07.mp3", "hl": [112, 117], "sp": "Naval", "oa": "audio/t02o/s07.mp3", "oab": [4.96, 7.11], "oas": ["audio/t02o/s07.mp3"], "zh": "有些人确实会，也许那就是他们的天性，但我觉得大多数人还是想行动，想亲自上场。", "zb": [29, 31], "sg": [[0, 43, "audio/t02o/s07.mp3", 0.08, 1.7], [44, 86, "audio/t02o/s07.mp3", 1.7, 4.66], [87, 118, "audio/t02o/s07.mp3", 4.96, 7.11]]}}, {"n": 7, "w": "aligned with", "pos": "adj. phrase", "zh": "与……一致；契合", "ex": "If something is aligned with your values or goals, it fits them and points the same way. Naval wants work that matches what he believes needs to be done. It's common in work and self-help talk.", "exs": ["This job is finally aligned with what I care about.", "Make sure your daily habits are aligned with your goals."], "t": 294.31, "tt": {"w": 294.31, "ex": [["If", 297.18], ["something", 297.27], ["is", 297.59], ["aligned", 297.85], ["with", 298.17], ["your", 298.63], ["values", 298.79], ["or", 299.25], ["goals,", 299.57], ["it", 300.59], ["fits", 300.67], ["them", 300.87], ["and", 301.19], ["points", 301.47], ["the", 301.71], ["same", 302.05], ["way.", 302.31], ["Naval", 303.25], ["wants", 303.45], ["work", 303.89], ["that", 304.23], ["matches", 304.47], ["what", 304.91], ["he", 306.17], ["believes", 307.44], ["needs", 307.44], ["to", 307.44], ["be", 307.44], ["done.", 307.44], ["It's", 307.44], ["common", 307.44], ["in", 307.46], ["work", 307.64], ["and", 307.95], ["self-help", 308.2], ["talk.", 308.82]], "exs": [[["This", 312.45], ["job", 312.72], ["is", 312.94], ["finally", 313.11], ["aligned", 313.55], ["with", 313.99], ["what", 31