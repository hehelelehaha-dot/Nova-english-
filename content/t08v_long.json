9.11]], "exs": [[["The", 862.39], ["success", 862.44], ["felt", 862.63], ["hollow.", 863.05]], [["The", 867.65], ["tree", 867.75], ["is", 867.97], ["hollow.", 868.25]]], "z": [864.33, 869.55], "o": 872.16}}, {"n": 34, "w": "deep down", "pos": "phrase", "zh": "内心深处", "ex": "Deep down means in your true feelings, even if you don't show it or say it.", "exs": ["Deep down, she knew he was right.", "Deep down, I'm a shy person."], "t": 875.18, "src": {"t": "and I think deep down you will know that and so it’ll be fragile and you’ll always be afraid of losing it and then you’ll be forced to perform.", "a": "audio/t08/s22.mp3", "hl": [12, 21], "sp": "Naval", "oa": "audio/t08o/s22.mp3", "oab": [0, 0.78]}, "tt": {"w": 875.18, "ex": [["Deep", 878.41], ["down", 878.53], ["means", 878.89], ["in", 879.23], ["your", 879.55], ["true", 879.65], ["feelings,", 879.85], ["even", 880.85], ["if", 881.15], ["you", 881.39], ["don't", 881.53], ["show", 881.77], ["it", 881.95], ["or", 882.17], ["say", 882.35], ["it.", 882.59]], "exs": [[["Deep", 885.78], ["down,", 885.95], ["she", 886.37], ["knew", 886.67], ["he", 886.79], ["was", 887.28], ["right.", 887.33]], [["Deep", 891.72], ["down,", 891.76], ["I'm", 892.12], ["a", 892.5], ["shy", 892.58], ["person.", 892.72]]], "z": [888.04, 894.06], "o": 897.4}}, {"n": 35, "w": "fragile", "pos": "adj.", "zh": "脆弱的；易碎的", "ex": "Fragile means easy to break or damage. It can be a thing, a feeling or a situation.", "exs": ["Natural lashes are fragile.", "His confidence is fragile."], "t": 899.44, "src": {"t": "and I think deep down you will know that and so it’ll be fragile and you’ll always be afraid of losing it and then you’ll be forced to perform.", "a": "audio/t08/s22.mp3", "hl": [57, 64], "sp": "Naval", "oa": "audio/t08o/s22.mp3", "oab": [1.8, 3.44]}, "tt": {"w": 899.44, "ex": [["Fragile", 902.56], ["means", 903.08], ["easy", 903.11], ["to", 903.53], ["break", 904.91], ["or", 905.04], ["damage.", 905.18], ["It", 905.31], ["can", 905.47], ["be", 905.59], ["a", 905.73], ["thing,", 905.83], ["a", 906.67], ["feeling", 906.69], ["or", 907.09], ["a", 907.45], ["situation.", 907.57]], "exs": [[["Natural", 911.27], ["lashes", 911.55], ["are", 911.95], ["fragile.", 912.35]], [["His", 916.64], ["confidence", 916.72], ["is", 917.16], ["fragile.", 917.54]]], "z": [913.73, 918.88], "o": 921.45}}, {"n": 36, "w": "celebrity", "pos": "n.", "zh": "名人；明星", "ex": "A celebrity is a famous person, especially in movies, music or TV.", "exs": ["A celebrity came to our salon!", "Celebrities have little privacy."], "t": 924.38, "src": {"t": "So the kind of fame that pure actors and celebrities have, I wouldn’t want, but the kind of fame that’s earned because you did something useful, why dodge that?", "a": "audio/t08/s23.mp3", "hl": [41, 52], "sp": "Naval", "oa": "audio/t08o/s23.mp3", "oab": [0.08, 4.78]}, "tt": {"w": 924.38, "ex": [["A", 927.61], ["celebrity", 927.74], ["is", 928.4], ["a", 928.6], ["famous", 928.73], ["person,", 929.2], ["especially", 929.73], ["in", 930.46], ["movies,", 930.66], ["music", 931.19], ["or", 931.59], ["TV.", 931.78]], "exs": [[["A", 935.28], ["celebrity", 935.38], ["came", 935.91], ["to", 936.18], ["our", 936.33], ["salon!", 936.55]], [["Celebrities", 940.74], ["have", 941.34], ["little", 941.6], ["privacy.", 941.95]]], "z": [937.61, 943.09], "o": 945.83}}, {"n": 37, "w": "dodge", "pos": "v.", "zh": "躲开；回避", "ex": "To dodge means to move quickly to avoid something, or to avoid doing something you don't want to do.", "exs": ["He dodged the question.", "Why dodge something good?"], "t": 951.88, "src": {"t": "So the kind of fame that pure actors and celebrities have, I wouldn’t want, but the kind of fame that’s earned because you did something useful, why dodge that?", "a": "audio/t08/s23.mp3", "hl": [149, 154], "sp": "Naval", "oa": "audio/t08o/s23.mp3", "oab": [8.38, 9.65]}, "tt": {"w": 951.88, "ex": [["To", 954.92], ["dodge", 955.09], ["means", 955.44], ["to", 955.78], ["move", 955.95], ["quickly", 956.