,", 719.02], ["just", 719.44], ["miserable", 719.74], ["outside.", 720.34]]], "z": [712.23, 721.54], "r": [714.65, 724.21], "o": 728.16, "rx": [[714.65, 714.75, 715.0, 715.5, 715.75, 715.85, 716.05, 716.24], [724.21, 724.5, 724.8, 725.04, 725.46, 725.76, 726.36]]}, "src": {"t": "Well, you end up with a series of miserable successes, right?", "a": "audio/t05/s10.mp3", "hl": [34, 43], "sp": "Chris", "oa": "audio/t05o/s10.mp3", "oab": [0.08, 4.2], "oas": ["audio/t05o/s10.mp3"], "zh": "嗯，不然你最后得到的就是一连串痛苦的成功，对吧？", "zb": [15, 18], "sg": [[0, 61, "audio/t05o/s10.mp3", 0.08, 4.2]]}}], "seqsig": "739095135ea4"}