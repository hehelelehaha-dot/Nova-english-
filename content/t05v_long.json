.72], ["in", 259.22], ["a", 259.39], ["team", 259.5], ["can", 259.79], ["slow", 260.01], ["everything", 260.29], ["down.", 260.91]]]}, "src": {"t": "For me, I would have done everything the same except I would have done it with less anger, less emotion, less internal suffering because that was optional. It wasn’t necessary.", "a": "audio/t05/s08.mp3", "hl": [110, 118], "sp": "Naval", "oa": "audio/t05o/s08.mp3", "oab": [8.2, 9.42]}}, {"n": 12, "w": "external", "pos": "adj.", "zh": "外部的；外在的（↔ internal）", "ex": "External means outside, coming from outside you or outside a group. External problems are things like bad weather or a rude customer. It is the opposite of internal.", "exs": ["Don't let external noise ruin your mood.", "This cream is for external use only."], "t": 262.34, "tt": {"w": 262.34, "ex": [["External", 265.11], ["means", 265.32], ["outside,", 265.66], ["coming", 267.0], ["from", 267.1], ["outside", 267.3], ["you", 267.58], ["or", 268.12], ["outside", 268.46], ["a", 268.86], ["group.", 269.16], ["External", 270.02], ["problems", 270.5], ["are", 271.06], ["things", 271.34], ["like", 271.62], ["bad", 272.0], ["weather", 272.32], ["or", 272.78], ["a", 273.02], ["rude", 273.24], ["customer.", 273.52], ["It", 274.66], ["is", 274.76], ["the", 274.86], ["opposite", 275.04], ["of", 275.5], ["internal.", 275.82]], "exs": [[["Don't", 279.38], ["let", 279.46], ["external", 279.6], ["noise", 280.04], ["ruin", 280.44], ["your", 280.84], ["mood.", 281.1]], [["This", 282.5], ["cream", 282.64], ["is", 282.9], ["for", 283.2], ["external", 283.36], ["use", 283.8], ["only.", 284.08]]]}, "src": null}, {"n": 13, "w": "at least", "pos": "phrase", "zh": "至少；最起码", "ex": "At least means not less than a certain amount, or the minimum. It can also mean something is still good even if things aren't perfect. Chris says do the job at least peacefully.", "exs": ["I need at least two hours for a full set.", "At least try it once."], "t": 285.85, "tt": {"w": 285.85, "ex": [["At", 288.