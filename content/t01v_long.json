{"type": "longaudio", "title": "Naval Topic 1 生词 · 英英解释", "audio": "audio/t01v/full.mp3", "items": [{"n": 1, "w": "dissatisfaction", "pos": "n.", "zh": "不满足；不满", "ex": "Dissatisfaction is the feeling that what you have is not good enough. You want more or you want something better. It is the opposite of being satisfied.", "exs": ["Her dissatisfaction with her old job made her start her own lash studio.", "A little dissatisfaction can push you to grow."], "t": 0.0, "src": {"t": "Happiness is being satisfied with what you have. Success comes from dissatisfaction. Is success worth it then?", "a": "audio/t01/s01.mp3", "hl": [68, 83], "sp": "Chris", "oa": "audio/t01o/s01.mp3", "oab": [3.64, 4.82], "oas": ["audio/t01o/s01.mp3"], "zh": "快乐就是满足于自己拥有的东西。成功来自不满足。那么，成功值得吗？", "zb": [19, 22], "sg": [[0, 48, "audio/t01o/s01.mp3", 0.0, 2.68], [49, 84, "audio/t01o/s01.mp3", 3.64, 4.82], [85, 110, "audio/t01o/s01.mp3", 6.16, 7.9]]}, "tt": {"w": 0.0, "ex": [["Dissatisfaction", 2.9], ["is", 3.83], ["the", 4.01], ["feeling", 4.24], ["that", 4.7], ["what", 4.99], ["you", 5.28], ["have", 5.51], ["is", 5.8], ["not", 5.98], ["good", 6.21], ["enough.", 6.5], ["You", 6.96], ["want", 7.19], ["more", 7.48], ["or", 7.77], ["you", 7.95], ["want", 8.18], ["something", 8.47], ["better.", 9.05], ["It", 9.51], ["is", 9.69], ["the", 9.86], ["opposite", 10.09], ["of", 10.61], ["being", 10.79], ["satisfied.", 11.14]], "exs": [[["Her", 15.02], ["dissatisfaction", 15.26], ["with", 16.23], ["her", 16.53], ["old", 16.77], ["job", 17.02], ["made", 17.26], ["her", 17.56], ["start", 17.8], ["her", 18.16], ["own", 18.4], ["lash", 18.65], ["studio.", 18.95]], [["A", 31.15], ["little", 31.25], ["dissatisfaction", 31.6], ["can", 32.39], ["push", 32.59], ["you", 32.84], ["to", 33.04], ["grow.", 33.19]]], "z": [20.21, 34.25], "r": [25.05, 37.42], "o": 41.12, "rx": [[25.05, 25.29, 26.26, 26.56, 26.8, 27.05, 27.29, 27.59, 27.83, 28.19, 28.43, 28.68, 28.98], [37.42, 37.52, 37.87, 38.66, 38.86, 39.11, 39.31, 39.46]]}},