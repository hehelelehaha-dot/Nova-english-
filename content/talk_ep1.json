      "end": 285.414,
      "segment": "takeaway"
    },
    {
      "sp": "Ethan",
      "t": "I picked up a few new skills from YouTube.",
      "a": "audio/talk_ep1/M_0de2a6191b48.mp3",
      "oa": "audio/talk_ep1/M_0de2a6191b48.mp3",
