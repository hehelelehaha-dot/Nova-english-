audio/t03o/s04.mp3", 0, 3.59], [114, 152, "audio/t03o/s04.mp3", 3.59, 5.15]]}}, {"n": 5, "w": "loop", "pos": "v./n.", "zh": "循环；兜圈子", "ex": "To loop means to go around and around and repeat. Keep looping on the same game means playing the same game again and again without moving on. It's also used for songs and videos that repeat.", "exs": ["This song has been looping in my head all day.", "Set the video to loop."], "t": 180.98, "tt": {"w": 180.98, "ex": [["To", 183.45], ["loop", 183.64], ["means", 183.64], ["to", 183.68], ["go", 183.94], ["around", 184.1], ["and", 184.44], ["around", 184.8], ["and", 185.04], ["repeat.", 185.48], ["Keep", 186.58], ["looping", 186.78], ["on", 187.3], ["the", 187.48], ["same", 187.6], ["game", 187.82], ["means", 188.2], ["playing", 188.64], ["the", 189.04], ["same", 189.28], ["game", 189.52], ["again", 190.06], ["and", 190.34], ["again", 190.54], ["without", 190.84], ["moving", 191.4], ["on.", 191.88], ["It's", 192.8], ["also", 193.04], ["used", 193.38], ["for", 193.66], ["songs", 193.94], ["and", 194.2], ["videos", 194.64], ["that", 194.98], ["repeat.", 195.3]], "exs": [[["This", 198.93], ["song", 198.98], ["has", 199.14], ["been", 199.38], ["looping", 199.58], ["in", 200.02], ["my", 200.12], ["head", 200.24], ["all", 200.5], ["day.", 200.78]], [["Set", 209.07], ["the", 209.12], ["video", 209.19], ["to", 209.43], ["loop.", 209.69]]], "z": [201.8, 210.67], "r": [205.13, 213.35], "o": 215.55, "rx": [[205.13, 205.18, 205.34, 205.58, 205.78, 206.22, 206.32, 206.44, 206.7, 206.98], [213.35, 213.4, 213.47, 213.71, 213.97]]}, "src": {"t": "You don’t wanna just keep looping on the same game over and over,", "a": "audio/t03/s05.mp3", "hl": [26, 33], "sp": "Naval", "oa": "audio/t03o/s05.mp3", "oab": [0.82, 2.78], "oas": ["audio/t03o/s05.mp3", "audio/t03o/s06.mp3"], "ft": "You don’t wanna just keep looping on the same game over and over, although a lot of these games are very enticing and have many levels that are relatively open-ended.", "fhl": [26, 33], "zh": "你不会想一直在同一个游戏里一遍又一遍地打转，虽然很多这类游戏都非常诱人，而且关卡很多，几乎没有尽头。", "sg": [[0, 25, "audio/t03o/s05.mp3", 0, 0.82], [26, 65, "audio/t03o/s05.mp3", 0.82, 2.78], [66, 95, "audio/t03o/s06.mp3", 0, 1.08], [96, 166, "audio/t03o/s06.mp3", 1.08, 3.55]]}}, {"n": 6, "w": "although", "pos": "conj.", "zh": "虽然；尽管", "ex": "Although connects two ideas that seem to go against each other. Naval says don't keep looping, although these games are very enticing. It means the same as even though, and sounds a bit more formal than but.", "exs": ["Although I was tired, I went to the gym.", "I liked the movie, although it was a little long."], "t": 223.46, "tt": {"w": 223.46, "ex": [["Although", 226.14], ["connects", 226.69], ["two", 227.25], ["ideas", 227.49], ["that", 227.86], ["seem", 228.17], ["to", 228.48], ["go", 228.67], ["against", 228.85], ["each", 229.35], ["other.", 229.66], ["Naval", 230.09], ["says", 230.46], ["don't", 230.77], ["keep", 231.14], ["looping,", 231.45], ["although", 232.0], ["these", 232.56], ["games", 232.93], ["are", 233.3], ["very", 233.54], ["enticing.", 233.85], ["It", 234.47], ["means", 234.66], ["the", 235.03], ["same", 235.27], ["as", 235.58], ["even", 235.77], ["though,", 236.07], ["and", 236.57], ["sounds", 236.82], ["a", 237.25], ["bit", 237.37], ["more", 237.62], ["formal", 237.93], ["than", 238.36], ["but.", 238.67]], "exs": [[["Although", 242.23], ["I", 242.77], ["was", 242.89], ["tired,", 243.13], ["I", 243.55], ["went", 243.67], ["to", 243.97], ["the", 244.15], ["gym.", 244.38]], [["I", 252.47], ["liked", 252.56], ["the", 252.86], ["movie,", 253.06], ["although", 253.4], ["it", 253.84], ["was", 253.99], ["a", 254.18], ["little", 254.28], ["long.", 254.63]]], "z": [245.3, 255.51], "r": [248.32, 258.64], "o": 262.28, "rx": [[248.32, 248.86, 248.98, 249.22, 249.64, 249.76, 250.06, 250.24, 250.47], [258.64, 258.73, 259.03, 259.23, 259.57, 260.01, 260.16, 260.35, 260.45, 260.8]]}, "src": {"t": "although a lot of these games are very enticing and ha