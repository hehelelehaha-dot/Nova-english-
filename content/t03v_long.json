], ["first", 374.08], ["to", 374.44], ["set", 374.68], ["up", 374.88], ["the", 375.02], ["choice.", 375.18]], "exs": [[["We", 378.84], ["can", 378.89], ["either", 378.98], ["eat", 379.26], ["in", 379.5], ["or", 379.88], ["go", 380.14], ["out.", 380.28]], [["Either", 388.08], ["you", 388.26], ["call", 388.4], ["her", 388.6], ["or", 388.8], ["I", 389.28], ["will.", 389.77]]], "z": [381.46, 390.55], "r": [384.53, 393.59], "o": 396.66, "rx": [[384.53, 384.58, 384.67, 384.95, 385.19, 385.57, 385.83, 385.97], [393.59, 393.77, 393.91, 394.11, 394.31, 394.79, 395.28]]}, "src": {"t": "and either you move to a different game or you play the game for the sheer joy of it.", "a": "audio/t03/s08.mp3", "hl": [4, 10], "sp": "Naval", "oa": "audio/t03o/s08.mp3", "oab": [0, 1.03], "oas": ["audio/t03o/s07.mp3", "audio/t03o/s08.mp3"], "ft": "Then you become free of the game, in the sense that you’re no longer trying to win it—you know you can win it— and either you move to a different game or you play the game for the sheer joy of it.", "fhl": [115, 121], "zh": "然后你就从游戏里解脱了，意思是你不再执着于赢它——你知道自己赢得了——接下来你要么换个游戏，要么纯粹为了好玩去玩它。", "zb": [39, 41], "sg": [[0, 33, "audio/t03o/s07.mp3", 0, 1.79], [34, 89, "audio/t03o/s07.mp3", 1.79, 4.92], [90, 110, "audio/t03o/s07.mp3", 4.92, 6.33], [111, 130, "audio/t03o/s08.mp3", 0, 1.03], [131, 157, "audio/t03o/s08.mp3", 1.03, 2.38], [158, 196, "audio/t03o/s08.mp3", 2.38, 4.17]]}}, {"n": 10, "w": "sheer", "pos": "adj.", "zh": "纯粹的；完全的", "ex": "Sheer means pure and nothing else, and it makes a feeling or amount sound very strong. For the sheer joy of it means only because it's fun, with no other goal. We also say sheer luck or sheer size.", "exs": ["She dances for the sheer joy of it.", "We won by sheer luck."], "t": 408.84, "tt": {"w": 408.84, "ex": [["Sheer", 411.33], ["means", 411.73], ["pure", 412.14], ["and", 412.47], ["nothing", 412.74], ["else,", 413.28], ["and", 413.28], ["it", 413.28], ["makes", 413.28], ["a", 413.78], ["feeling", 414.0], ["or", 414.36],